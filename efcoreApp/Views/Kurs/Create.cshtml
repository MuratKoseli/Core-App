@model KursViewModel

<h2>Kurs Ekle</h2>
<hr>

<form asp-controller="Kurs" asp-action="Create" method="post">
     <div asp-validation-summary="All"></div> @* Hata mesajlarını almak için kullanıyoruz. Boş bırakılmaması vs gibi hatalar için. *@
    <div class="mb-3">
        <label asp-for="Baslik" class="form-label">Kurs Adı</label>
        <input asp-for="Baslik" class="form-control">
    </div>
    <div class="mb-3">
        <label asp-for="OgretmenId" class="form-label">Öğretmen</label>
        <select asp-for="OgretmenId" asp-items="ViewBag.Ogretmenler" class="form-select">
            <option value="">Seçiniz</option>
        </select>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-secondary">Kaydet</button>
    </div>

</form>