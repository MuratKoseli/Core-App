@model IEnumerable<Ogretmen>

<h2>Öğretmen Listesi</h2>
<a asp-action="Create" class="btn btn-sm btn-primary">Öğretmen Ekle</a>
<hr>


<table class="table table-bordered">
    <thead>
        <tr>
            <th style="width: 150px;" >@Html.DisplayNameFor(m => m.OgretmenId)</th>
            <th>@Html.DisplayNameFor(m => m.Ad)</th>
            <th>@Html.DisplayNameFor(m => m.Soyad)</th>
            <th style="width: 250px;">@Html.DisplayNameFor(m => m.BaslamaTarihi)</th>
            <th style="width: 180px;"></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var ogt in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => ogt.OgretmenId)</td>
                <td>@Html.DisplayFor(modelItem => ogt.Ad)</td>
                <td>@Html.DisplayFor(modelItem => ogt.Soyad)</td>
                <td>@Html.DisplayFor(modelItem => ogt.BaslamaTarihi)</td>
                <td><a asp-controller="Ogretmen" asp-action="Edit" asp-route-id="@ogt.OgretmenId" class="btn btn-sm btn-success" style="width: 70px;">Güncelle</a>
                <a asp-controller="Ogretmen" asp-action="Delete" asp-route-id="@ogt.OgretmenId" class="btn btn-sm btn-danger" style="width: 70px;">Sil</a>
                </td>
            </tr>
        }

    </tbody>
</table>